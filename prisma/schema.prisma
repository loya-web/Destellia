generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

enum TutoringSessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  role             UserRole          @default(STUDENT)
  grade            String?
  createdAt        DateTime          @default(now())
  studentSessions  TutoringSession[] @relation("StudentSessions")
  tutorSessions    TutoringSession[] @relation("TutorSessions")
}

model Scholarship {
  id          String    @id @default(cuid())
  title       String
  description String
  url         String
  deadline    DateTime?
  category    String
  isActive    Boolean   @default(true)
}

model TutoringSession {
  id          String                 @id @default(cuid())
  studentId   String
  tutorId     String?
  subject     String
  topic       String?
  scheduledAt DateTime
  meetingLink String?
  status      TutoringSessionStatus @default(PENDING)
  student     User                   @relation("StudentSessions", fields: [studentId], references: [id])
  tutor       User?                  @relation("TutorSessions", fields: [tutorId], references: [id])
}
